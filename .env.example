# Copy to .env and fill in. Never commit .env.
N8N_ENCRYPTION_KEY=
N8N_HOST_PORT=8088
WEBHOOK_URL=
TZ=Asia/Kolkata
SDR_DB_PASSWORD=

# ── LLM (OpenAI-compatible) ──
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5-mini

# ── Slack (api.slack.com/apps → SDR Agent) ──
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# ── Clay (webhook source URLs of both tables) ──
CLAY_T1_WEBHOOK_URL=
CLAY_T2_WEBHOOK_URL=
# Clay HTTP API columns send this in header x-sdr-secret
CLAY_CALLBACK_SECRET=

# ── HubSpot ──
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=

# ── HeyReach ──
HEYREACH_API_KEY=
HEYREACH_LINKEDIN_ACCOUNT_ID=
HEYREACH_NOANSWER_CAMPAIGN_ID=
HEYREACH_POSTCALL_CAMPAIGN_ID=

# ── Instantly ──
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# ── Buyer persona for account expansion (sent to Clay Table 2) ──
BUYER_PERSONA=

# ── Supabase (session pooler; the direct db.<ref> host is IPv6-only) ──
SUPABASE_URL=
PG_HOST=
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=
PG_PASSWORD=
PG_SSL=require
PG_ALLOW_UNAUTHORIZED_CERTS=true

# ── Enrichment (replaces Clay Table 1) ──
DEEPLINE_API_KEY=
PROSPEO_API_KEY=
ENRICH_PROVIDER=deepline_prospeo
