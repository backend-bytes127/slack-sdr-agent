        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payload: { currentCompanies: $('Decide').first().json.lead.company_linkedin_url || $('Decide').first().json.lead.company_name } }) }}"
