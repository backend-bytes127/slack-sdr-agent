      "name": "Fit (LLM)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Score how well each person fits this buyer persona. An SDR wants other people to call at the same account.\n\nPersona: {{ $env.BUYER_PERSONA || 'senior decision makers in sales, growth or revenue' }}\nOriginal lead: {{ $('Decide').first().json.lead.title }} at {{ $('Decide').first().json.lead.company_name }}\n\nPeople (index. title | headline):\n{{ $json.candidates.map((c, i) => i + '. ' + (c.title || 'n/a') + ' | ' + String(c.headline || '').slice(0, 120)).join('\\n') }}\n\nReturn JSON only, no markdown: [{\"i\": <index>, \"score\": <1-5>, \"reason\": \"<one short line>\"}] with one entry per person.",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "5c798a6b-2c76-5acd-9fe7-c642417cb838",
      "name": "LLM",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1920,
        220
      ],
      "parameters": {
        "model": {
          "__rl": true,
