      "id": "3ef6d0b2-c8b5-51b5-8b15-42938a33f7d4",
      "name": "Create expansion run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "with l as (select * from leads where id = $1::uuid),\nrecent as (\n  select r.id, r.created_at, x.slack_channel_id as rc, x.slack_thread_ts as rt\n  from expansion_runs r join leads x on x.id = r.lead_id, l\n  where l.company_domain is not null and r.company_domain = l.company_domain\n    and r.created_at > now() - interval '30 days' and r.status <> 'error'\n  order by r.created_at desc limit 1\n),\nins as (\n  insert into expansion_runs (lead_id, company_domain, company_name, slack_channel_id, slack_thread_ts)\n  select l.id, l.company_domain, l.company_name, l.slack_channel_id, l.slack_thread_ts from l\n  where (l.company_domain is not null or l.company_linkedin_url is not null) and not exists (select 1 from recent)\n  returning *\n)\nselect l.*, (select row_to_json(recent) from recent) as recent_run,\n       (select row_to_json(ins) from ins) as new_run\nfrom l",
        "options": {
          "queryReplacement": "={{ [$json.lead_id ?? null] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "sdrPostgres00001",
          "name": "SDR Postgres"
        }
      }
    },
    {
      "id": "6ca22530-016e-5e86-aa76-3e3e1d88fabe",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// After the start-expansion SQL: either search the account for a new run, or explain why not.\nconst row = $input.first().json;\nconst company = row.company_name || row.company_domain || 'this company';\nconst permalink = (channel, ts) => (channel && ts ? `https://slack.com/archives/${channel}/p${String(ts).replace('.', '')}` : null);\n\nif (row.new_run) {\n  return [{ json: { start: true, run: row.new_run, lead: row } }];\n}\n\nlet text;\nif (!row.company_domain && !row.company_linkedin_url) {\n  text = `:mag: Can't search for colleagues: no company was found for ${row.full_name || 'this lead'}.`;\n} else if (row.recent_run) {\n  const when = new Date(row.recent_run.created_at).toISOString().slice(0, 10);\n  const link = permalink(row.recent_run.rc, row.recent_run.rt);\n  text = `:mag: Already searched *${company}* on ${when}${link ? ` (<${link}|see that thread>)` : ''}. No new search spend.`;\n} else {\n  text = `:mag: Could not start the colleague search for ${company}.`;\n}\n\nreturn [{ json: { start: false, payload: { channel: row.slack_channel_id, thread_ts: row.slack_thread_ts, text } } }];\n"
      }
    },
