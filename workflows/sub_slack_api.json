      "waitBetweenTries": 5000
    },
    {
      "id": "3f2499da-8fc8-5bcd-9b2f-111ab0f45513",
      "name": "Check ok",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// Slack returns HTTP 200 with ok:false on errors, so fail loudly here.\nconst res = $input.first().json;\nconst input = $('Called by parent').first().json;\nif (!res.ok) {\n  const detail = res.response_metadata && res.response_metadata.messages\n    ? ` (${res.response_metadata.messages.join('; ')})` : '';\n  throw new Error(`Slack ${input.method} failed: ${res.error}${detail}`);\n}\nreturn [{ json: res }];\n"
      }
    }
  ],
