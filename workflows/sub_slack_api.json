      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SLACK_API_BASE || 'https://slack.com/api') + '/' + $json.method }}",
